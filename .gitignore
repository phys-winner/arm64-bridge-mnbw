# Publish only bridge/control sources, their tests, and required open-source code.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/arm64_bridge/
/arm64_bridge/*
!/arm64_bridge/CMakeLists.txt
!/arm64_bridge/build_arm64.ps1
!/arm64_bridge/build_arm64.bat
!/arm64_bridge/check_symbols.py
!/arm64_bridge/src/
!/arm64_bridge/tests/
!/arm64_bridge/patches/
!/arm64_bridge/third_party/
/arm64_bridge/third_party/*
!/arm64_bridge/third_party/boost/
!/arm64_bridge/third_party/astcenc/
!/arm64_bridge/third_party/texture2ddecoder/
!/work/
/work/*
!/work/controls/
!/work/render_targets/

# These local regression fixtures contain extracted original game machine code.
/arm64_bridge/tests/render-buffers-fixtures.h
/arm64_bridge/tests/render-commit-fixtures.h
/arm64_bridge/tests/warband_*_test.cpp

# Historical QA needs private game dumps or a machine-specific compiler setup.
/work/controls/check_chat_*.py
/work/controls/check_tactical_guest_events.py
/work/controls/test_poll_contract.py
/work/controls/test_mission_ui_predicates.py

**/.git
**/.git/
**/__pycache__/
**/.pytest_cache/
**/build/
**/build_*/
**/dist/
